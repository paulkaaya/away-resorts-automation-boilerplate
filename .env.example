# Active environment — must match a key wired in utils/environmentManager.ts
ENV=dev
# Add more envs by creating config/<env>.ts and wiring it into utils/environmentManager.ts

# Auth credentials (optional).
# By default the auth scaffold reads credentials from config/<env>.ts. If you
# prefer to keep secrets out of the repo, uncomment these and read them in your
# config instead, e.g. `primaryUserEmail: process.env.PRIMARY_USER_EMAIL`.
# PRIMARY_USER_EMAIL=
# PRIMARY_USER_PASSWORD=
# SECONDARY_USER_EMAIL=
# SECONDARY_USER_PASSWORD=
