{
  "name": "playwright-boilerplate",
  "version": "1.0.0",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "first:install": "pnpm install && pnpm run test:install && husky",
    "test": "playwright test",
    "test:qa": "ENV=qa playwright test",
    "test:staging": "ENV=staging playwright test",
    "test:update": "pnpm add -D @playwright/test@latest",
    "test:install": "playwright install",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/compat": "^2.1.0",
    "@playwright/test": "1.61.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testmo/testmo-cli": "1.4.9",
    "@types/node": "25.9.3",
    "@types/pixelmatch": "5.2.6",
    "@types/pngjs": "6.0.5",
    "@typescript-eslint/eslint-plugin": "8.63.0",
    "@typescript-eslint/parser": "8.63.0",
    "dotenv": "17.4.2",
    "eslint": "10.6.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-jsdoc": "^63.2.0",
    "eslint-plugin-playwright": "2.10.5",
    "get-port": "7.2.0",
    "husky": "^9.1.7",
    "pixelmatch": "7.2.0",
    "playwright-lighthouse": "4.0.0",
    "playwright-testmo-reporter": "1.19.2",
    "pngjs": "7.0.0",
    "prettier": "3.9.4",
    "typescript": "6.0.3"
  }
}
