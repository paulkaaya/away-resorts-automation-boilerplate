  "POM: page object class": {
    "scope": "typescript",
    "prefix": "/pom",
    "body": [
      "import { BasePage } from '@pages/BasePage';",
      "import type { Locator, Page } from '@playwright/test';",
      "import type { EnvironmentManager } from '@utils/environmentManager';",
      "",
      "export class ${TM_FILENAME_BASE} extends BasePage {",
      "  readonly ${1:elementName}: Locator;",
      "",
      "  constructor(page: Page, envManager: EnvironmentManager) {",
      "    super(page, envManager);",
      "    this.url = this.baseUrl + '${2:/path}';",
      "",
      "    this.$1 = this.page.getByTestId('${3:test-id}');",
      "  }",
      "",
      "  async ${4:actionName}(): Promise<void> {",
      "    $0",
      "  }",
      "}",
      "",
    ],
    "description": "Scaffold a new Page Object class extending BasePage (objects/pages), defaulting to getByTestId per the golden rules",
  },

  "POM: component object class": {
    "scope": "typescript",
    "prefix": "/pom-component",
    "body": [
      "import type { Locator, Page } from '@playwright/test';",
      "",
      "export class ${TM_FILENAME_BASE} {",
      "  readonly page: Page;",
      "  readonly ${1:root}: Locator;",
      "",
      "  constructor(page: Page) {",
      "    this.page = page;",
      "    this.$1 = this.page.getByTestId('${2:test-id}');",
      "  }",
      "",
      "  async ${3:actionName}(): Promise<void> {",
      "    $0",
      "  }",
      "}",
      "",
    ],
    "description": "Scaffold a new reusable component object class (objects/components), matching HeaderNavigation.ts/FooterNavigation.ts — no BasePage inheritance",
  },

