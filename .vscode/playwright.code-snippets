  "Spec: new page quality-check file": {
    "scope": "typescript",
    "prefix": "/page-spec",
    "body": [
      "import { test } from '@base';",
      "",
      "test.describe('${1:page name} quality check', { tag: ['@quality-gate'] }, () => {",
      "  test.describe.configure({",
      "    retries: 0,",
      "  });",
      "",
      "  test('quality gate', async ({ qualityGate, basePage }) => {",
      "    await qualityGate(basePage);",
      "  });",
      "",
      "  test('${1:page name} accessibility check', async ({ accessibility, basePage }) => {",
      "    await accessibility(basePage);",
      "  });",
      "",
      "  test('${1:page name} performance check', async ({ lighthouse, basePage }) => {",
      "    await lighthouse(basePage, '${2:/path}');",
      "  });",
      "});",
      "",
    ],
    "description": "Scaffold a new page quality-check spec file: retries disabled, describe-level @quality-gate tag (config/projects.ts grepInverts it everywhere except Chrome, so it only runs there), and qualityGate/accessibility/lighthouse fixture tests",
  },

