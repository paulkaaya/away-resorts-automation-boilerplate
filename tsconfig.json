{
  "compilerOptions": {
    "target": "es2016",
    "module": "commonjs",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsc/.tsbuildinfo",
    "paths": {
      "@base": ["./testFixtures/base"],
      "@utils/*": ["./utils/*"],
      "@pages/*": ["./objects/pages/*"],
      "@components/*": ["./objects/components/*"],
      "@types": ["./types/types"]
    }
  }
}
